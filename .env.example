# Copy this file to .env and fill in your values.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/eyeClinicAssistant?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/eyeClinicAssistant_test?schema=public"

# Key for hashing login codes. Any long random string; keep it secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# true = the "Try as demo patient" login works. Turn off for anything public.
DEMO_MODE="true"

# Signs the 5-minute tokens the API gives the agent for one chat turn. Keep secret;
# only the API needs it (the agent just passes tokens on).
AGENT_TOKEN_SECRET="replace-with-a-long-random-string"

# Where the Python agent service runs, and the key the API uses to call it.
AGENT_URL="http://localhost:8001"
AGENT_SERVICE_KEY="replace-with-a-long-random-string"

# The AI model. Any OpenAI-compatible provider: change these four lines to switch.
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="your-api-key"
LLM_MODEL="model-name"
# Tried when LLM_MODEL fails (rate limit, outage). Optional.
LLM_FALLBACK_MODEL="another-model-name"
# Optional: "none" turns off a thinking model's reasoning (Qwen 3.5 on Ollama thinks by
# default, about twice as slow). Leave empty for the provider's default.
LLM_REASONING_EFFORT=""
# How long one model call may take, in seconds. Raise it if a local model times out.
LLM_TIMEOUT_SECONDS="60"
# Local Qwen on Ollama: build the model from agent/ollama/Modelfile, then
#   LLM_BASE_URL="http://localhost:11434/v1"  LLM_API_KEY="ollama"
#   LLM_MODEL="qwen3.5-9b-16k"  LLM_FALLBACK_MODEL=""  LLM_REASONING_EFFORT="none"

# Email (login codes, reminders). Leave SMTP_HOST empty to print emails in the API log.
# Development: Mailpit catches every email locally, nothing reaches a real inbox.
#   install: winget install axllent.mailpit   run: mailpit   inbox: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
# true only for port 465 (TLS from the start). Mailpit and port 587 use false.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Demo Eye Clinic <no-reply@clinic.example>"
# How often the API sends due reminders, in seconds. 0 = off.
NOTIFICATIONS_EVERY_SECONDS="60"

# Where the agent reaches the clinic API (and its /mcp tools).
CLINIC_API_URL="http://localhost:3000"

# Evals: their own database (wiped for every case) and model-call pacing for free tiers.
EVAL_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/eyeClinicAssistant_eval?schema=public"
EVAL_MAX_LLM_CALLS_PER_MINUTE="12"
# Optional: a different model to grade wording (defaults to LLM_MODEL).
# EVAL_GRADER_MODEL="model-name"
# Optional: grade wording with a different provider from the agent (e.g. Gemini while
# the agent runs on a local model), so a model never marks its own answers.
# EVAL_GRADER_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# EVAL_GRADER_API_KEY="your-api-key"
