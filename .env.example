# Copy this file to .env and fill in your values.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/eyeClinicAssistant?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/eyeClinicAssistant_test?schema=public"

# Key for hashing login codes. Any long random string; keep it secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"

# true = the "Try as demo patient" login works. Turn off for anything public.
DEMO_MODE="true"

# Signs the 5-minute tokens the API gives the agent for one chat turn. Keep secret;
# only the API needs it (the agent just passes tokens on).
AGENT_TOKEN_SECRET="replace-with-a-long-random-string"

# Where the Python agent service runs, and the key the API uses to call it.
AGENT_URL="http://localhost:8001"
AGENT_SERVICE_KEY="replace-with-a-long-random-string"
