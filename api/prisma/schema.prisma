// Clinic API schema.
//
// Rules Prisma cannot express live in the hand-edited migration SQL:
// the btree_gist exclusion constraint and CHECK constraints.
// All timestamps are UTC (timestamptz). Local clinic times are converted using
// ClinicSetting.timezone.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ResourceKind {
  OPTOMETRIST
  TECHNICIAN
  SCANNER
}

/// Extra training a resource has. A step can require one.
/// Technicians: PRETEST, SCAN. Optometrists: CONTACT_LENS, PAEDIATRIC.
enum Skill {
  PRETEST
  SCAN
  CONTACT_LENS
  PAEDIATRIC
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

/// Single row (id = 1). Admin-editable later.
model ClinicSetting {
  id          Int    @id @default(1)
  name        String
  /// IANA zone where the clinic physically is, e.g. "Asia/Karachi".
  /// Working hours are interpreted in this zone. Viewers see times in their own zone.
  timezone    String
  /// Slots start on this grid, in minutes.
  slotGridMin Int    @default(15) @map("slot_grid_min")
  /// Clinics differ: whether the agent offers a FOLLOW_UP after a new_prescription outcome.
  offerRecheckAfterNewPrescription Boolean @default(false) @map("offer_recheck_after_new_prescription")
  /// How long after first recording an outcome its doctor may still correct it.
  outcomeEditWindowHours Int @default(72) @map("outcome_edit_window_hours")
  /// The appointment reminder email goes out this many hours before the start.
  reminderHoursBefore Int @default(24) @map("reminder_hours_before")
  /// The yearly check-up email goes out this many months after the last annual-type visit.
  annualReminderMonths Int @default(11) @map("annual_reminder_months")

  @@map("clinic_settings")
}

/// Anything that can be booked: a staff member or a machine.
model Resource {
  id           String               @id @default(uuid()) @db.Uuid
  kind         ResourceKind
  displayName  String               @map("display_name")
  /// Empty for machines. Used to match steps and to break ties (fewer skills first).
  skills       Skill[]
  active       Boolean              @default(true)
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  allocations  ResourceAllocation[]
  /// The login account, for doctors.
  staffUser    StaffUser?

  @@map("resources")
}

enum StaffRole {
  DOCTOR
  RECEPTION
  ADMIN
}

/// A clinic staff login. Created by the seed or an admin, never by signing up.
model StaffUser {
  id          String     @id @default(uuid()) @db.Uuid
  /// Trimmed and lower-case (CHECK constraint).
  email       String     @unique
  displayName String     @map("display_name")
  role        StaffRole
  /// Doctors only (CHECK constraint): which bookable resource this doctor is.
  resourceId  String?    @unique @map("resource_id") @db.Uuid
  resource    Resource?  @relation(fields: [resourceId], references: [id])
  /// false = can't log in, and open sessions stop working.
  active      Boolean    @default(true)
  sessions    Session[]
  outcomes    Outcome[]

  @@map("staff_users")
}

/// A weekly working window in clinic-local time. Several windows per day allow breaks.
model WorkingHours {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  /// ISO weekday: 1 = Monday ... 7 = Sunday (matches Luxon).
  weekday    Int
  /// Minutes after local midnight, e.g. 540 = 09:00.
  startMin   Int      @map("start_min")
  endMin     Int      @map("end_min")

  @@index([resourceId, weekday])
  @@map("working_hours")
}

/// One-off absence (leave, maintenance), stored in UTC.
model TimeOff {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  reason     String?

  @@index([resourceId])
  @@map("time_off")
}

model AppointmentType {
  id               String                @id @default(uuid()) @db.Uuid
  code             String                @unique
  name             String
  /// How long the visit usually takes (shown to the patient). The calendar time
  /// actually blocked is where the last step ends; step lengths include the slack.
  typicalMin       Int                   @map("typical_min")
  prepInstructions String                @map("prep_instructions")
  isUrgent         Boolean               @default(false) @map("is_urgent")
  /// Visits that should happen every year (e.g. the routine eye test): the patient gets
  /// a check-up reminder when the last one is ClinicSetting.annualReminderMonths old.
  annualReminder   Boolean               @default(false) @map("annual_reminder")
  active           Boolean               @default(true)
  steps            AppointmentTypeStep[]
  appointments     Appointment[]

  @@map("appointment_types")
}

/// One resource needed during a visit. Rows with the same offset run in parallel
/// (scan = scanner + skilled technician); later offsets run in sequence.
/// Every step is fully reserved; none is optional.
model AppointmentTypeStep {
  id                String          @id @default(uuid()) @db.Uuid
  appointmentTypeId String          @map("appointment_type_id") @db.Uuid
  appointmentType   AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)
  position          Int
  resourceKind      ResourceKind    @map("resource_kind")
  /// Only resources with this skill can take the step.
  requiredSkill     Skill?          @map("required_skill")
  offsetMin         Int             @map("offset_min")
  /// Reserved length of this step, slack included. Admin-editable.
  durationMin       Int             @map("duration_min")

  @@unique([appointmentTypeId, position])
  @@map("appointment_type_steps")
}

/// Synthetic patients only. Created on first login; name and date of birth are
/// filled in before the first booking.
model Patient {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String?       @map("full_name")
  /// Always trimmed and lower-case (CHECK constraint), so one person = one account.
  email        String        @unique
  /// Second check before results are shown, so it is never sent back to the client.
  dateOfBirth  DateTime?     @map("date_of_birth") @db.Date
  /// The seeded patient behind the "Try as demo patient" button.
  isDemo       Boolean       @default(false) @map("is_demo")
  /// Display zone the patient chose, so it follows them across devices. Never used for booking maths.
  timezone     String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  appointments Appointment[]
  sessions     Session[]
  conversations Conversation[]
  handoffs     HandoffRequest[]
  notifications Notification[]

  @@map("patients")
}

/// Which door a login code opens. Kept apart so a patient code never logs anyone into staff.
enum LoginPurpose {
  PATIENT
  STAFF
}

/// A one-time login code. Only a keyed hash is stored; rows are kept for rate limiting.
model LoginCode {
  id         String       @id @default(uuid()) @db.Uuid
  purpose    LoginPurpose @default(PATIENT)
  email      String
  /// HMAC-SHA256(AUTH_SECRET, email:code). Useless without the secret.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  requestIp  String?   @map("request_ip")
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@index([email, purpose, createdAt])
  @@index([requestIp, createdAt])
  @@map("login_codes")
}

/// A logged-in browser. The cookie holds a random token; only its SHA-256 hash is stored.
/// Belongs to exactly one patient or one staff member (CHECK constraint).
model Session {
  id                String     @id @default(uuid()) @db.Uuid
  tokenHash         String     @unique @map("token_hash")
  patientId         String?    @map("patient_id") @db.Uuid
  patient           Patient?   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffUserId       String?    @map("staff_user_id") @db.Uuid
  staffUser         StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  /// When this session last passed the date-of-birth check (unlocks results briefly).
  dobVerifiedAt     DateTime?  @map("dob_verified_at") @db.Timestamptz(3)
  dobFailedAttempts Int        @default(0) @map("dob_failed_attempts")

  @@index([patientId])
  @@index([staffUserId])
  @@map("sessions")
}

enum AuditActorType {
  PATIENT
  STAFF
  SYSTEM
}

/// Who did what, when. Append-only (a trigger blocks UPDATE and DELETE).
/// No foreign keys, so the history survives deleted records.
/// Never holds login codes, session tokens, dates of birth or doctors' notes.
model AuditEvent {
  id         String         @id @default(uuid()) @db.Uuid
  at         DateTime       @db.Timestamptz(3)
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  entityType String?        @map("entity_type")
  entityId   String?        @map("entity_id") @db.Uuid
  ip         String?
  details    Json?

  @@index([actorType, actorId, at])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model Appointment {
  id                String               @id @default(uuid()) @db.Uuid
  /// Booking ticket code, e.g. EC-7K3QFM.
  reference         String               @unique
  patientId         String               @map("patient_id") @db.Uuid
  patient           Patient              @relation(fields: [patientId], references: [id])
  appointmentTypeId String               @map("appointment_type_id") @db.Uuid
  appointmentType   AppointmentType      @relation(fields: [appointmentTypeId], references: [id])
  startsAt          DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime             @map("ends_at") @db.Timestamptz(3)
  status            AppointmentStatus    @default(BOOKED)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt       DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  allocations       ResourceAllocation[]
  outcome           Outcome?
  notifications     Notification[]

  @@index([patientId])
  @@map("appointments")
}

enum NotificationType {
  APPOINTMENT_REMINDER
  ANNUAL_CHECKUP
}

/// One email the clinic sends on its own (not login codes). The row is written BEFORE
/// sending, as a claim: the unique (type, dedupe_key) means each email goes out once,
/// even if two workers run at the same moment. sentAt stays empty until delivery
/// succeeds; a failed send deletes the claim so the next run tries again.
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  type          NotificationType
  /// What makes it "the same email": an appointment and its start time for a reminder
  /// (moving it earns a new one), the visit it follows for the yearly check-up.
  dedupeKey     String           @map("dedupe_key")
  patientId     String           @map("patient_id") @db.Uuid
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?          @map("appointment_id") @db.Uuid
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  claimedAt     DateTime         @map("claimed_at") @db.Timestamptz(3)
  sentAt        DateTime?        @map("sent_at") @db.Timestamptz(3)

  @@unique([type, dedupeKey])
  @@index([patientId])
  @@map("notifications")
}

/// The four results a doctor can record. The agent may read only this and the note.
enum OutcomeCode {
  NO_CHANGE
  NEW_PRESCRIPTION
  FOLLOW_UP_6_MONTHS
  REFERRAL_TO_SPECIALIST
}

/// What the doctor decided after an exam. There is deliberately no field for
/// measurements anywhere in the schema: the agent can't see clinical data even by accident.
model Outcome {
  id                String      @id @default(uuid()) @db.Uuid
  appointmentId     String      @unique @map("appointment_id") @db.Uuid
  appointment       Appointment @relation(fields: [appointmentId], references: [id])
  code              OutcomeCode
  /// Written by the doctor for the patient, passed on word for word. 1-500 characters.
  patientNote       String      @map("patient_note")
  recordedByStaffId String      @map("recorded_by_staff_id") @db.Uuid
  recordedBy        StaffUser   @relation(fields: [recordedByStaffId], references: [id])
  recordedAt        DateTime    @map("recorded_at") @db.Timestamptz(3)
  /// Set when the doctor corrects it; the patient sees an "edited" tag.
  correctedAt       DateTime?   @map("corrected_at") @db.Timestamptz(3)
  offersShown       OfferShown[]

  @@map("outcomes")
}

/// Something the clinic can offer after a result, e.g. "Two pairs for $90".
/// Only offered when the patient's latest outcome is one of appliesTo.
model Offer {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  title       String
  description String
  appliesTo   OutcomeCode[] @map("applies_to")
  active      Boolean       @default(true)
  shown       OfferShown[]

  @@map("offers")
}

/// "Made once, never pushed": each offer is shown at most once per outcome.
model OfferShown {
  id        String   @id @default(uuid()) @db.Uuid
  offerId   String   @map("offer_id") @db.Uuid
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  outcomeId String   @map("outcome_id") @db.Uuid
  outcome   Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  shownAt   DateTime @map("shown_at") @db.Timestamptz(3)

  @@unique([offerId, outcomeId])
  @@map("offers_shown")
}

enum HandoffStatus {
  OPEN
  CLOSED
}

/// The agent passing something to a person: medical questions, complaints, anything unclear.
model HandoffRequest {
  id             String        @id @default(uuid()) @db.Uuid
  /// Empty when the visitor wasn't logged in.
  patientId      String?       @map("patient_id") @db.Uuid
  patient        Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reason         String
  status         HandoffStatus @default(OPEN)
  createdAt      DateTime      @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("handoff_requests")
}

/// A chat with the agent. Owned by a logged-in patient, or by an anonymous visitor's
/// browser (a random key in a cookie; only its hash is stored). Kept 30 days.
model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  patientId     String?          @map("patient_id") @db.Uuid
  patient       Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  anonKeyHash   String?          @map("anon_key_hash")
  createdAt     DateTime         @map("created_at") @db.Timestamptz(3)
  lastMessageAt DateTime         @map("last_message_at") @db.Timestamptz(3)
  messages      ChatMessage[]
  handoffs      HandoffRequest[]

  @@index([patientId])
  @@index([anonKeyHash])
  @@map("conversations")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  /// Order of messages, from the database. Timestamps can tie; this never does.
  seq            Int          @unique @default(autoincrement())
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  text           String
  /// Shown next to the reply by the web page, never sent to the LLM (e.g. the doctor's note).
  cards          Json?
  /// For rate limiting user messages.
  requestIp      String?      @map("request_ip")
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)

  @@index([conversationId, seq])
  @@map("chat_messages")
}

/// The time a booking claims on one resource. The exclusion constraint on this
/// table is what makes double booking impossible.
model ResourceAllocation {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resourceId    String      @map("resource_id") @db.Uuid
  resource      Resource    @relation(fields: [resourceId], references: [id])
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime    @map("ends_at") @db.Timestamptz(3)
  /// false once the appointment is cancelled; inactive rows stop blocking the slot.
  active        Boolean     @default(true)

  @@index([appointmentId])
  @@map("resource_allocations")
}
